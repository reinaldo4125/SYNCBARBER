rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /salon_system/{documentId} {
      allow read, write: if true;
    }
    match /salon_tenants/{tenantId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
